<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1E6"
    tools:context=".View.Home">


    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="246dp"
        android:layout_height="253dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/emotifylogo" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="89dp"
        android:layout_height="36dp"
        android:layout_marginTop="72dp"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:text="Hello,"
        android:textColor="@color/army"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.844"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:text="how are you"
        android:textColor="@color/army"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView5"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/textView5"
        app:layout_constraintTop_toBottomOf="@id/textView5" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:text="today?"
        android:textColor="@color/army"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/textView6"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/textView6"
        app:layout_constraintTop_toBottomOf="@id/textView6" />


    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="119dp"
        android:layout_height="97dp"
        android:layout_marginTop="16dp"
        android:background="#FFF1E6"
        android:scaleType="fitCenter"
        android:src="@drawable/cameraicon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.876"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView7" />

    <ImageView
        android:id="@+id/imageView25"
        android:layout_width="225dp"
        android:layout_height="234dp"
        android:layout_marginEnd="204dp"
        android:clickable="true"
        android:src="@drawable/homejournal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageButton" />

    <ImageView
        android:id="@+id/imageView26"
        android:layout_width="225dp"
        android:layout_height="234dp"
        android:layout_marginStart="204dp"
        android:layout_marginTop="108dp"
        android:clickable="true"
        android:src="@drawable/hometracker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView25" />

    <ImageView
        android:id="@+id/imageView27"
        android:layout_width="229dp"
        android:layout_height="237dp"
        android:layout_marginTop="156dp"
        android:layout_marginEnd="204dp"
        android:clickable="true"
        android:src="@drawable/homegethelp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageView26" />

</androidx.constraintlayout.widget.ConstraintLayout>
