<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1E6"
    tools:context=".View.Signup">

    <ImageView
        android:id="@+id/imageView30"
        android:layout_width="259dp"
        android:layout_height="236dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/emotifylogo" />

    <Button
        android:id="@+id/button2"
        android:layout_width="129dp"
        android:layout_height="62dp"
        android:backgroundTint="@color/army"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:text="Sign Up"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.713" />

    <EditText
        android:id="@+id/editTextTextPassword2"
        android:layout_width="248dp"
        android:layout_height="55dp"
        android:background="@color/lightblue"
        android:ems="10"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:hint="         Enter Password"
        android:includeFontPadding="false"
        android:inputType="textPassword"
        android:textColorHint="@color/lightbrowwn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.421" />

    <EditText
        android:id="@+id/editTextTextPassword3"
        android:layout_width="248dp"
        android:layout_height="55dp"
        android:background="@color/lightblue"
        android:ems="10"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:hint="       Re-Enter Password"
        android:includeFontPadding="false"
        android:inputType="textPassword"
        android:textColorHint="@color/lightbrowwn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.573" />

    <EditText
        android:id="@+id/editTextTextEmailAddress2"
        android:layout_width="248dp"
        android:layout_height="55dp"
        android:background="@color/lightblue"
        android:ems="10"
        android:fontFamily="@font/kaisei_tokumin_medium"
        android:hint="             Enter Email"
        android:includeFontPadding="false"
        android:inputType="textEmailAddress"
        android:textColorHint="@color/lightbrowwn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.276" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Already have an account?"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.293"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button2"
        app:layout_constraintVertical_bias="0.132" />

    <Button
        android:id="@+id/button3"
        android:layout_width="99dp"
        android:layout_height="44dp"
        android:backgroundTint="#FFF1E6"
        android:text="Login"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.746"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.784" />

</androidx.constraintlayout.widget.ConstraintLayout>